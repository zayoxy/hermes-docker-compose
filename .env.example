# Hermes Agent Docker Compose - Environment Variables
# Copy this file to .env and edit as needed.

# Host path for persistent hermes data (default: ~/.hermes)
# HERMES_DATA_DIR=~/.hermes

# Host port for the gateway API (default: 8642)
# GATEWAY_PORT=8642

# Host port for the dashboard UI (default: 9120)
# DASHBOARD_PORT=9120

# Dashboard login (required for non-loopback binds such as Docker port mapping)
DASHBOARD_AUTH_USERNAME=admin
DASHBOARD_AUTH_PASSWORD=change-me
# Generate one with: openssl rand -hex 32
DASHBOARD_AUTH_SECRET=change-me-to-a-random-32-byte-hex-string

# Ollama local model server
# Host path for downloaded models (if not set default: ~/.ollama)
OLLAMA_DATA_DIR=./.ollama
# A systemd-managed Ollama often stores models in /var/lib/ollama/.ollama.
# Reuse them by setting OLLAMA_DATA_DIR to that path (write access is required
# for new pulls).
# OLLAMA_DATA_DIR=/var/lib/ollama/.ollama
# Host port for the Ollama API (default: 11434). Hermes uses
# http://ollama:11434 internally, so changing this only affects host access.
OLLAMA_PORT=11434
# Default context window for loaded models (default: 65536)
OLLAMA_CONTEXT_LENGTH=65536
# How long an idle model stays in memory (default: 30m)
OLLAMA_KEEP_ALIVE=30m
